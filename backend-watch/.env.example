# Supabase server credentials. Keep service keys out of the Expo app.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional preferred alias; if set, takes precedence over SUPABASE_SERVICE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Shared server-side AI provider. AI_API_KEY may be empty; source/template fallbacks remain available.
AI_PROVIDER=gemini
AI_API_KEY=
# Gemini default; select a provider-compatible model if changing AI_PROVIDER.
AI_MODEL=gemini-3.5-flash-lite
# Optional API root override for the selected provider.
AI_BASE_URL=

# Expo push access token; only needed when enhanced push security is enabled.
EXPO_ACCESS_TOKEN=

# Keep monitoring a condition for this many minutes before creating an alert event.
WEATHER_ALERT_SUSTAINED_MINUTES=60
# Optional chatbot service base URL. Leave empty to disable chatbot requests.
CHATBOT_API_URL=

# Optional authorized Meta Graph API token for official Facebook page access.
FACEBOOK_ACCESS_TOKEN=
# Optional semicolon-free comma-separated host allowlist for trusted announcement sources.
TRUSTED_ANNOUNCEMENT_DOMAINS=pagasa.dost.gov.ph
# Optional server-only token for legacy admin confirmation flows.
ANNOUNCEMENT_ADMIN_TOKEN=
# Only needed when running scripts/bootstrap-admin.mjs; keep this server-only.
WATCH_ADMIN_PASSWORD=

# Ongoing weather safety-tip delivery tuning.
SAFETY_TIP_INTERVAL_HOURS=3
SAFETY_TIP_MAX_PER_HAZARD_USER=3
# Consecutive fresh weather readings required by the legacy hazard monitor.
HAZARD_CONSECUTIVE_READINGS=2

# Test-only admin hazard route. Keep disabled in production.
ENABLE_TEST_ENDPOINTS=false
# Render sets PORT automatically; local default is 3000.
PORT=3000

# Optional commit/build metadata exposed by GET /health.
RENDER_GIT_COMMIT=
GIT_COMMIT=
SOURCE_COMMIT=
BUILD_TIME=
RENDER_DEPLOY_CREATED_AT=
